# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://dignityhomehealthcare.com

# Contact form email delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Comma-separated list of recipients for new consultation requests
CONTACT_TO_EMAIL=info@dignityhomehealthcare.com
# Verified sender address; defaults to Resend's onboarding sender when unset
CONTACT_FROM_EMAIL=
